.env
# .env.<cliente> do social_scheduler (tokens reais); os .example são o molde
.env.*
!.env.example
!.env.social.example
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
output/

# config*.py contém o access token real — nunca deve ser commitado.
# (padrão config_<conta>.py pra ter tokens separados por cliente/conta,
# ex.: config_1818.py — config.example.py continua liberado, é só o molde)
config.py
config_*.py
*.xlsx
.state/
