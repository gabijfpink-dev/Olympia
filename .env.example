# Credenciais do app Meta (criado em https://developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=

# Token de acesso com permissoes ads_management e ads_read
# (token de usuario do sistema de longa duracao é o mais indicado para automacao)
META_ACCESS_TOKEN=

# ID da conta de anuncios, com ou sem o prefixo "act_"
META_AD_ACCOUNT_ID=

# Versao da Graph API a ser usada (opcional, tem um padrao definido no codigo)
META_API_VERSION=v21.0

# --- promo_bot (captura de promocoes no Telegram) ---
# Credenciais do SEU app Telegram, criadas de graca em https://my.telegram.org
# (nao e um bot token: loga com a sua propria conta para ler os grupos em que
# voce ja esta).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Nome do arquivo de sessao local (gerado na primeira vez que voce logar)
TELEGRAM_SESSION_NAME=promo_bot
