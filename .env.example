# Credenciais do app Meta (criado em https://developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=

# Token de acesso com permissoes ads_management e ads_read
# (token de usuario do sistema de longa duracao é o mais indicado para automacao)
META_ACCESS_TOKEN=

# ID da conta de anuncios, com ou sem o prefixo "act_"
META_AD_ACCOUNT_ID=

# Versao da Graph API a ser usada (opcional, tem um padrao definido no codigo)
META_API_VERSION=v21.0
