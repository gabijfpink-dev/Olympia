# Copie para .env.<cliente> (ex.: .env.bebetto) e preencha. NUNCA commite o
# arquivo preenchido (.env.* já está no .gitignore).
# Rodar: python -m social_scheduler run --schedule posts/agenda.xlsx --env-file .env.bebetto

# ---------- Meta (Facebook + Instagram) ----------
# Token de usuário (ou usuário do sistema) — só pra rodar 'meta-accounts' e
# descobrir os valores abaixo. Não é usado pra publicar.
META_USER_ACCESS_TOKEN=

# Saída do comando 'meta-accounts':
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Versão da Graph API (opcional)
META_GRAPH_VERSION=v23.0

# Só se usar "Login do Instagram" em vez do login do Facebook (opcional):
# META_IG_ACCESS_TOKEN=
# META_IG_GRAPH_HOST=graph.instagram.com

# ---------- LinkedIn ----------
# Do app em https://www.linkedin.com/developers/apps (aba Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Saída do comando 'linkedin-auth' (token vale ~60 dias):
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Versão da API do LinkedIn, formato AAAAMM (opcional; atualize se der erro de versão)
LINKEDIN_VERSION=202608

# ---------- Geral ----------
# Fuso usado quando publish_at não tem fuso (opcional)
SCHEDULER_TIMEZONE=America/Sao_Paulo
